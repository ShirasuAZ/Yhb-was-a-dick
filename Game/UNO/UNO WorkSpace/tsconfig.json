{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@uno-client/*": ["client/src/*"],
      "@arknights/*": ["../../unionarena/UnionArenaWorkSpace/Arknights/src/client/*"],
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"],
      "socket.io-client": ["node_modules/socket.io-client"],
