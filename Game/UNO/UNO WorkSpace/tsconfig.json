  "include": ["client/src", "server", "shared", "tests", "electron", "../../unionarena/UnionArenaWorkSpace/Arknights/src/client", "../../unionarena/UnionArenaWorkSpace/Arknights/src/server", "../../unionarena/UnionArenaWorkSpace/Arknights/src/shared", "../../Hon shugi/Hon shugi WorkSpace/src/engine.ts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
