# Server port. Most hosting providers set this automatically.
PORT=3000

# Bind to all interfaces so other devices on the network / internet can connect.
HOST=0.0.0.0

# Optional: only needed if the browser client is served from a different origin.
# CLIENT_ORIGIN=https://uno.example.com

# Set to 1 to open LAN access immediately. Leave unset for the local desktop default (closed).
# UNO_LAN_OPEN=1

# Allow the machine running the server to toggle LAN access from the UI.
# Set to 0 on public deployments behind a reverse proxy.
UNO_HOST_CONTROL=1

# Account database directory. Defaults to ./data.
UNO_DATA_DIR=./data

# Directory containing ArknightsWorkSpace Cards/images and Map/对战地图.png.
# Set this to the mounted asset directory in production; Map.png is not used.
# UNION_ARENA_WORKSPACE_DIR=/app/arknights

# Email changes are disabled unless all SMTP values are configured.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
